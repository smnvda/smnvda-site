---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import content from '../data/content.json';
import '../styles/styles.css'

const { profile, home, sections } = content;
const previewSections = sections.filter(section => section.showOnHome);
---


<!DOCTYPE html>
<html
>
  <Header title={`${profile.name} — ${profile.role}`} />
  <body>
    <div class="content">
      <Sidebar selectedItem="home" />
      <nav class="main">
        <div class="container">
          <main class="fold-content-container">
            <div class="fold-content">
              <h1>{profile.name}<br />{home.heroTitle}</h1>
              <p class="lead">{home.heroSubtitle}</p>
            </div>
            <a href={home.contactHref} class="button w-button">Contact</a>
          </main>
          <div class="projects-section">
            {previewSections.map(section => (
              <a href={section.href} class="projects-container">
                <div class="single-projects-category">
                  <div class="projects-category-image-container">
                    <img src={section.previewIcon} loading="lazy" alt="" class="projects-category-image" />
                  </div>
                </div>
                <div class="single-projects-content">
                  <h4>{section.label}</h4>
                  <div class="tech-tools-container">
                    <div class="mini-label-white gray-color">Technologies &amp; tools</div>
                    <div class="chips-container chips-container-small-width">
                      {section.previewTags.map(tag => (
                        <div class="single-chip small-chip">{tag}</div>
                      ))}
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
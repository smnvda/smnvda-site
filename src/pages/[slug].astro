---
import Header from '../components/Header.astro';
import Project from '../components/Project.astro';
import Sidebar from '../components/Sidebar.astro';
import content from '../data/content.json';
import '../styles/styles.css'

export function getStaticPaths() {
  return content.sections.map(section => ({
    params: { slug: section.href.replace(/^\//, '') },
    props: { section },
  }));
}

const { profile } = content;
const { section } = Astro.props;
---

<!DOCTYPE html>
<html
>
  <Header title={`${section.label} | ${profile.name}`} />
  <body>
    <div class="content">
        <Sidebar selectedItem={section.key} />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1>{section.label}</h1>
            <p class="lead">{section.description}</p>
            <section class="items-container">
                <div class="resouce-items">
                    {section.cards.map(card => (
                      <Project
                        title={card.title}
                        desc={card.desc}
                        tech={card.tech}
                      />
                    ))}
                  </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>

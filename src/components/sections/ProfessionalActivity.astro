---
import Section from "../Section.astro";

import { professionalActivities } from "@cv";
---

<Section className={Astro.props.className} title="Профессиональная деятельность">
	<div class="grid grid-cols-1 gap-3 md:grid-cols-3">
		{
			professionalActivities.map(({ type, title, role, period, description, isbn }) => (
				<article class="activity ring-skin-muted flex flex-col rounded-md bg-skin-button-muted/50 px-4 py-3 ring-1">
					<p class="type-label">{type}</p>
					<h3 class="title">{title}</h3>
					<p class="role">{role}</p>
					{period && <p class="period">{period}</p>}
					{description && <p class="note">{description}</p>}
					{isbn && <p class="note">ISBN {isbn}</p>}
				</article>
			))
		}
	</div>
</Section>

<style>
	/* Карточки намеренно легче, чем в «Ключевых трансформациях»: меньше padding,
	   без иконок, списков и акцентной заливки — только рамка и приглушённый фон. */
	.activity {
		transition: border-color 150ms linear;
		border: 1px solid transparent;
	}

	.activity:hover {
		border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
	}

	/* Единственное место с акцентом — маленький type-label над названием. */
	.type-label {
		font-size: 0.6875rem;
		line-height: 1rem;
		letter-spacing: 0.02em;
		font-weight: 500;
		color: color-mix(in srgb, var(--color-accent) 75%, var(--color-text-muted));
	}

	.title {
		margin-top: 0.25rem;
		font-size: 1rem;
		line-height: 1.375rem;
		font-weight: 500;
		color: var(--color-text-base);
	}

	.role {
		margin-top: 0.125rem;
		font-size: 0.8125rem;
		line-height: 1.125rem;
		font-weight: 600;
		color: var(--color-text-base);
	}

	.period {
		margin-top: 0.125rem;
		font-size: 0.75rem;
		line-height: 1.125rem;
		color: var(--color-text-muted);
	}

	.note {
		margin-top: 0.375rem;
		font-size: 0.75rem;
		line-height: 1.125rem;
		color: var(--color-text-muted);
	}
</style>

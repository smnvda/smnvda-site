---
import { basics } from "@cv";
import Section from "@/components/Section.astro";
import Mail from "@/icons/Mail.astro";
import Phone from "@/icons/Phone.astro";
import X from "@/icons/X.astro";
import LinkedIn from "@/icons/LinkedIn.astro";
import GitHub from "@/icons/GitHub.astro";
import Telegram from "@/icons/Telegram.astro";
import Contact from "@/icons/Contact.astro";
import WorldMap from "@/icons/WorldMap.astro";
import type { SocialIcon } from "@/types";

const { name, label, image, location, profiles, phone, email } = basics;
const { city, region } = location;

const SOCIAL_ICONS: SocialIcon = {
	GitHub,
	LinkedIn,
	X,
	Telegram,
};

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn");
const linkedUrl = linkedInfo?.url;

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ");

// tel: не любит пробелы и скобки — в ссылке только цифры, на экране номер как в cv.json
const phoneHref = phone?.replace(/[^+\d]/g, "");

// Профили выводятся username-ом, а не названием сети: Telegram — @username, MAX — "MAX: username".
// MAX в данных пока нет, поэтому ничего не рендерится — появится сам при добавлении в basics.profiles.
const contactLabel = (network: string, username?: string) => {
	if (!username) return network;
	if (network === "Telegram") return username.startsWith("@") ? username : `@${username}`;
	if (network === "MAX") return `MAX: ${username}`;
	return username;
};

const contactProfiles = profiles.filter(({ url, username }) => url || username);
---

<Section>
	<div class="flex flex-col-reverse gap-8">
		<div class="info">
			<h1>{name}</h1>
			<h2>{label}</h2>
			<div class="flex items-center gap-2 pt-2 text-sm text-skin-muted">
				<WorldMap />
				{city}, {region}
			</div>
			<footer class="print">
				{printInfo}
			</footer>
			<footer class="no-print contacts">
				{
					email && (
						<a class="contact" href={`mailto:${email}`} title={`Написать на ${email}`} draggable="false">
							<span class="contact-icon">
								<Mail />
							</span>
							<span class="contact-value">{email}</span>
						</a>
					)
				}
				{
					phone && (
						<a class="contact" href={`tel:${phoneHref}`} title={`Позвонить: ${phone}`} draggable="false">
							<span class="contact-icon">
								<Phone />
							</span>
							<span class="contact-value">{phone}</span>
						</a>
					)
				}
				{
					contactProfiles.map(({ network, username, url }) => {
						const Icon = SOCIAL_ICONS[network] ?? Contact;
						const label = contactLabel(network, username);

						return (
							<a class="contact" href={url} title={`${network}: ${label}`} target="_blank" rel="noopener noreferrer" draggable="false">
								<span class="contact-icon">
									<Icon />
								</span>
								<span class="contact-value">{label}</span>
							</a>
						);
					})
				}
			</footer>
		</div>
		<figure class="print:hidden w-fit relative">
			<img class="shadow-lg shadow-skin-hues" src={image} alt={name} />
			<div class="pointer-events-none absolute -inset-2">
				<div class="absolute -inset-y-8 right-0 w-px bg-skin-hue/50 [mask-image:linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"></div>
				<div class="absolute -inset-y-8 left-0 w-px bg-skin-hue/50 [mask-image:linear-gradient(to_top,transparent,white_4rem,white_calc(100%-4rem),transparent)]"></div>
				<div class="absolute -inset-x-8 bottom-0 h-px bg-skin-hue/50 [mask-image:linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"></div>
				<div class="absolute -inset-x-8 top-0 h-px bg-skin-hue/50 [mask-image:linear-gradient(to_left,transparent,white_4rem,white_calc(100%-4rem),transparent)]"></div>
			</div>
		</figure>
	</div>
</Section>

<style>
	.info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding-right: 2rem;
	}

	@media print {
		.info {
			gap: 0;
			padding-right: 0;
		}
	}

	h1 {
		font-size: 2.25rem;
		line-height: 2.5rem;
		font-weight: 700;
	}

	@media print {
		h1 {
			font-size: 1.875rem;
			line-height: 2.25rem;
		}
	}

	h2 {
		text-wrap: balance;
		font-size: 1rem;
		line-height: 1.5rem;
		color: var(--color-text-muted);
	}

	@media print {
		h2 {
			font-size: 1.125rem;
			line-height: 1.75rem;
		}
	}

	img {
		aspect-ratio: 1 / 1;
		width: 8rem;
		border-radius: 1rem;
		background-size: cover;
	}

	span {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.75rem;
		line-height: 1rem;
		color: var(--color-accent);
	}

	footer {
		margin-top: 0.5rem;
		display: flex;
		gap: 0.25rem;
		font-size: 0.875rem;
		line-height: 1.25rem;
	}

	footer a, footer button {
		display: inline-flex;
		width: 2rem;
		height: 2rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.375rem;
		padding: 0.25rem;
		transition-property: all;
		transition-timing-function: linear;
		transition-duration: 500ms;
		color: var(--color-accent);
	}

	footer a:hover, footer button:hover {
		background-color: var(--color-button-accent);
		color: var(--color-text-inverted);
	}

	/* Контакты: вертикальный список «иконка + текст», не ряд кнопок.
	   Текст обычный и выделяемый, ссылка — дополнительная функция. */
	footer.contacts {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.125rem;
	}

	footer.contacts .contact {
		width: auto;
		height: auto;
		max-width: 100%;
		justify-content: flex-start;
		gap: 0.5rem;
		border-radius: 0.25rem;
		padding: 0.125rem 0;
		color: var(--color-text-muted);
		transition-duration: 150ms;
	}

	footer.contacts .contact:hover {
		background-color: transparent;
		color: var(--color-text-base);
	}

	footer.contacts .contact-icon {
		display: flex;
		width: 1rem;
		flex: none;
		align-items: center;
		justify-content: center;
		color: var(--color-accent);
	}

	footer.contacts .contact-value {
		display: inline;
		font-size: 0.875rem;
		line-height: 1.25rem;
		color: inherit;
		overflow-wrap: anywhere;
	}

	@media (width <= 700px) {
		.container {
			flex-direction: column-reverse;
		}

		.info {
			padding-right: 0;
		}

		h2 {
			text-wrap: balance;
		}
	}

	@media (min-width: 768px) {
		@media (width <= 700px) {
			.info {
				align-items: center;
				justify-content: center;
			}

			figure {
				display: flex;
				align-items: center;
				justify-content: center;
				margin-left: auto;
				margin-right: auto;
			}
		}
	}
</style>

<script>
	// Handle print mode - remove dark theme when printing
	const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

	window.addEventListener("beforeprint", () => {
		document.documentElement.classList.remove("dark");
	});

	window.addEventListener("afterprint", () => {
		const savedTheme = localStorage.getItem("theme") || "system";
		const effectiveTheme = savedTheme === "system" ? systemTheme : savedTheme;
		if (effectiveTheme === "dark") {
			document.documentElement.classList.add("dark");
		}
	});
</script>

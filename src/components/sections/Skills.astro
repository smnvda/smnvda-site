---
import Section from "../Section.astro";
import { skills } from "@cv";

const PRIMARY_TAG =
	"border-skin-hue/20 bg-skin-button-accent/20 border border-solid rounded-md px-2 py-0.5 text-xs text-skin-hue print:border-none print:bg-transparent print:p-0 print:text-zinc-800";
const SECONDARY_TAG =
	"border-skin-muted/25 bg-skin-button-muted/50 border border-solid rounded-md px-2 py-0.5 text-xs text-skin-muted print:border-none print:bg-transparent print:p-0 print:text-zinc-800";
---

<Section className={Astro.props.className} title="Экспертиза">
	<div class="flex flex-col gap-4 print:gap-2">
		{
			skills.map(({ name, type, keywords }) => (
				<div class="flex flex-col gap-1.5">
					<h4 class="text-sm font-semibold text-skin-base">{name}</h4>
					<ul class="flex flex-wrap gap-2">
						{keywords.map((keyword) => (
							<li class={type === "secondary" ? SECONDARY_TAG : PRIMARY_TAG}>{keyword}</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</Section>

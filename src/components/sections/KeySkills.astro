---
import Section from "../Section.astro";
import { skills, methods } from "@cv";

// Шкала — стилизация под цепочку BPMN activities: 5 task-блоков, соединённых
// стрелками. Уровень навыка = число закрашенных блоков, цифр и подписей нет.
const SCALE_STEPS = 5;
---

<Section className={Astro.props.className} title="Ключевые навыки">
	<div class="skills">
		{
			skills.map(({ name, level }) => (
				<div class="skill">
					<h4 class="skill-name">{name}</h4>
					<div class="scale" role="img" aria-label={`${name}: уровень ${level} из ${SCALE_STEPS}`}>
						{Array.from({ length: SCALE_STEPS }, (_, index) => (
							<Fragment>
								{index > 0 && (
									<svg class="connector" width="7" height="6" viewBox="0 0 7 6" fill="none" aria-hidden="true">
										<path d="M0 3h6M4.2 1.4 6 3 4.2 4.6" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
								<span class:list={["task", index < level && "task-active"]} />
							</Fragment>
						))}
					</div>
				</div>
			))
		}
	</div>

	{
		methods.length > 0 && (
			<p class="methods">
				<span class="methods-label">Методы и нотации:</span> {methods.join(" · ")}
			</p>
		)
	}
</Section>

<style>
	.skills {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
	}

	.skill-name {
		font-size: 0.8125rem;
		line-height: 1.25rem;
		font-weight: 500;
		color: var(--color-text-base);
	}

	/* Фиксированные размеры и nowrap: шкала не растягивается по ширине колонки
	   ни на desktop, ни на mobile — всегда прижата к левому краю. */
	.scale {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0;
		margin-top: 0.25rem;
		width: fit-content;
	}

	.task {
		width: 26px;
		height: 15px;
		flex: none;
		border: 1px solid color-mix(in srgb, var(--color-text-muted) 35%, transparent);
		border-radius: 3px;
		background-color: transparent;
	}

	.task-active {
		border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
		background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.connector {
		flex: none;
		color: color-mix(in srgb, var(--color-text-muted) 60%, transparent);
	}

	.methods {
		margin-top: 1rem;
		font-size: 0.75rem;
		line-height: 1.125rem;
		color: var(--color-text-muted);
	}

	.methods-label {
		font-weight: 500;
	}
</style>

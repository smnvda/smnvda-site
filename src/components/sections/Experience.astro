---
import Section from "../Section.astro"
import ExternalLink from "../ExternalLink.astro"
import { work } from "@cv"

import HTML from "@/icons/html.astro"
import CSS from "@/icons/css.astro"
import JavaScript from "@/icons/javascript.astro"
import TypeScript from "@/icons/type.astro"
import React from "@/icons/react.astro"
import Node from "@/icons/node.astro"
import MySQL from "@/icons/sql.astro"
import Git from "@/icons/git.astro"
import GitHub from "@/icons/GitHub.astro"
import Tailwind from "@/icons/tailwind.astro"
import Next from "@/icons/next.astro"
import Swift from "@/icons/swift.astro"
import SwiftUI from "@/icons/swiftui.astro"
import Kotlin from "@/icons/kotlin.astro"
import Flutter from "@/icons/flutter.astro"

// Смысловые якоря в текстах размечаются в cv.json как **фрагмент** — опт-ин:
// строки без разметки рендерятся как раньше, поэтому правило безопасно для всех work[].
// Возвращает чередующиеся куски: чётные — обычный текст, нечётные — выделенные.
const splitEmphasis = (text: string) => text.split(/\*\*(.+?)\*\*/)

// Ранний опыт (до 2017) показывается компактнее, чтобы не конкурировать с текущим:
// меньше заголовок, плотнее блок и нейтральные теги вместо акцентных.
const EARLY_EXPERIENCE_BEFORE = 2017

const SKILL_TAG_BASE = "print:p-0 print:bg-transparent print:text-zinc-800 flex gap-1 items-center border-solid print:border-none border rounded-md px-2 py-0.5 text-xs"
const SKILL_TAG = `bg-skin-button-accent/20 border-skin-hue/20 text-skin-hue ${SKILL_TAG_BASE}`
const SKILL_TAG_MUTED = `bg-skin-button-muted/50 border-skin-muted/25 text-skin-muted ${SKILL_TAG_BASE}`

const SKILLS_ICONS: Record<string, any> = {
  HTML,
  CSS,
  JavaScript,
  TypeScript,
  React,
  Node,
  MySQL,
  Git,
  GitHub,
  Next,
  Tailwind,
  Swift,
  SwiftUI,
  Kotlin,
  Flutter,
}
---
<Section className={Astro.props.className} title="Опыт">
  <ul class="flex flex-col">
    {work.map(({ name, startDate, endDate, position, summary, responsibilities, achievements, url, skills, location, location_type }) => {
      const startYear = new Date(startDate).getFullYear()
      const endYear = endDate != null ? new Date(endDate).getFullYear() : "Present"
      const isEarly = startYear < EARLY_EXPERIENCE_BEFORE

      return (
        <li class="relative print:py-2">
          <div class="group relative grid pb-1 print:pb-0 transition-all print:grid-cols-1 print:gap-1 sm:grid-cols-12 sm:gap-8 md:gap-6 lg:hover:!opacity-100 ">
            <header class="relative mt-1 text-xs font-semibold sm:col-span-2">
              <time datetime={startDate} data-title={startDate}>{startYear}</time> - <time datetime={endDate} data-title={endDate}>{endYear}</time>
            </header>
            <div class={`relative flex flex-col ${isEarly ? "pb-4" : "pb-6"} print:pb-0 before:-ml-6 sm:col-span-10 before:w-px print:before:hidden before:absolute before:bg-skin-muted before:opacity-30 before:h-full before:mt-2`}>
            <div class="absolute w-2 h-2 bg-skin-muted rounded-full mt-2 -translate-x-[1.71rem] ring print:hidden ring-skin-fill"></div>
              <h3>
                <div class={`inline-flex items-center ${isEarly ? "text-base" : "text-lg"} print:text-base leading-tight group/link focus-visible:text-amber-500`} aria-label="{position} - {company}">
                  <span>{position} <span>@</span> 
                  {url ? (
                    <ExternalLink href={url} text={name} title={`Ver ${name}`} />
                  ) : (
                    <span>{name}</span>
                  )}
                  </span>
                </div>
              </h3>
              {(location || location_type) && (
                <div class="text-xs text-skin-muted">
                  {location} {location && location_type && '-'} {location_type}
                </div>
              )}
              <div class="mt-4  print:gap-0 flex flex-col gap-4 print:text-xs text-sm" x-data="{ expanded: false }">
                {summary && (
                  <div class="flex flex-col gap-1">
                    <h4>Кратко:</h4>
                    <ul class="text-skin-muted [&>li]:ml-4 flex list-disc flex-col gap-2">
                      {(Array.isArray(summary) ? summary : [summary]).map(item => (
                        <li>
                          {splitEmphasis(item).map((part, index) => (
                            index % 2 === 1 ? <span class="font-semibold">{part}</span> : part
                          ))}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {(responsibilities || achievements) &&  (
                <div class="md:after:from-skin-fill dark:md:after:to-skin-fill/0  flex relative flex-col print:!h-auto gap-4 print:gap-2 md:after:bg-gradient-to-t md:after:absolute md:after:bottom-0 md:after:w-full print:after:hidden md:after:h-12 md:after:content-[''] " :class="expanded ? 'after:hidden' : ''" x-show="expanded" {...(isEarly ? { "x-collapse.min.0px": true } : { "x-collapse.min.50px": true })}>
                {responsibilities && (
                  <div class="flex flex-col gap-1">
                    <h4>Зона ответственности:</h4>
                    <ul class="text-skin-muted [&>li]:ml-4 flex list-disc flex-col gap-2">
                      {responsibilities.map(responsibility => (
                        <li>
                          {splitEmphasis(responsibility).map((part, index) => (
                            index % 2 === 1 ? <span class="font-semibold">{part}</span> : part
                          ))}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {achievements && (
                  <div class="flex flex-col gap-1">
                    <h4>Достижения:</h4>
                    <ul class="achievements text-skin-muted [&>li]:ml-4 [&>li]:list-disc flex list-disc flex-col gap-2">
                      {achievements.map(achievement => {
                        const separatorIndex = achievement.indexOf("\u2014")
                        const title = separatorIndex > 0 ? achievement.slice(0, separatorIndex).trim() : null
                        const description = separatorIndex > 0 ? achievement.slice(separatorIndex + 1).trim() : null

                        return (
                          <li>
                            {title ? (
                              <Fragment><span class="font-semibold">{title}</span> — {description}</Fragment>
                            ) : (
                              achievement
                            )}
                          </li>
                        )
                      })}
                    </ul>
                  </div>
                )}
                </div>
                
                <button @click="expanded = ! expanded" class="print:hidden group/more w-fit cursor-pointer items-center justify-center gap-1.5 text-xs underline text-skin-muted transition-all hover:text-skin-base flex">
                  <span x-text="expanded ? 'Свернуть' : 'Подробнее'">Подробнее</span>
                  <svg class="w-4 h-4 group-hover/more:translate-y-0.5 duration-200 ease-out" :class="{ 'rotate-180': expanded }" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>


                <ul class="flex print:hidden flex-wrap gap-2" aria-label="Technologies used">
                  {skills && skills.map(skill => {
                    const iconName = skill === "Next.js" ? "Next" : skill
                    const Icon = SKILLS_ICONS[iconName]
                    return (
                      <li class={isEarly ? SKILL_TAG_MUTED : SKILL_TAG}>
                        {Icon && <Icon />} <span>{skill}</span>
                      </li>
                    )
                  })}
                </ul>
)}
              </div>
            </div>
        </div>
        </li>
      )
    })}
  </ul>  
</Section>

<style>
  li::marker {
    color: var(--color-accent);
  }

  ul.achievements > li::marker {
    color: currentColor;
    font-size: 0.75em;
  }
</style>
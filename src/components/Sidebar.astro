---
import content from '../data/content.json';

const { selectedItem } = Astro.props;
const { profile, home, sections } = content;
---

<aside
  data-animation="default"
  data-collapse="medium"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="sidebar w-nav"
>
  <div class="nav-content">
    <a href="/" class="w-nav-brand" aria-label="home">
      <div class="niv-data">
        <img
          src={profile.photo}
          loading="eager"
          alt="Profile picture"
          class="niv-image"
        />
        <div>
          <div class="label-white">{profile.name}</div>
          <div class="label-gray">{profile.role}</div>
        </div>
      </div>
    </a>

    <nav role="navigation" class="w-nav-menu">
      <a
        href="/"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'home' ? 'w--current' : ''
        }`}
        aria-current={selectedItem === 'home' ? 'page' : undefined}
      >
        <img
          src={home.navIcon}
          loading="eager"
          alt=""
          class="nav-link-image"
        />
        <div>Home</div>
      </a>
      {sections.map(section => (
        <a
          href={section.href}
          class={`nav-link-container w-inline-block ${
            selectedItem === section.key ? 'w--current' : ''
          }`}
          aria-current={selectedItem === section.key ? 'page' : undefined}
        >
          <img
            src={section.navIcon}
            loading="eager"
            alt=""
            class="nav-link-image"
          />
          <div>{section.label}</div>
        </a>
      ))}
    </nav>

    <div
      class="navbar-icon-button w-nav-button"
      style="-webkit-user-select: text;"
      aria-label="menu"
      role="button"
      tabindex="0"
    >
      <img
        src="/assets/menu.svg"
        loading="eager"
        alt=""
        class="navbar-icon"
      />
    </div>
  </div>

  <script>
    import { setupNav } from '../scripts/nav.js';
    
    let cleanup;
    document.addEventListener('astro:page-load', () => {
      if (cleanup) cleanup();
      cleanup = setupNav();
    });

    document.addEventListener('astro:before-swap', () => {
      if (cleanup) cleanup();
    });
  </script>
</aside>
